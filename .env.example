# API Configuration
NEXT_PUBLIC_API_URL=https://api.s6infra.com

# Contact form email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=s6infra@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_FROM_EMAIL=s6infra@gmail.com
CONTACT_TO_EMAIL=s6infra@gmail.com

# Optional Google Sheets storage
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_SHEET_NAME=Enquiries
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Authentication (optional)
# NEXT_AUTH_SECRET=your-nextauth-secret
# NEXT_AUTH_URL=http://localhost:3000

# Database (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/s6infra_db
